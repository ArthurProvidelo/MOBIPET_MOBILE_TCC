<?xml version="1.0" encoding="utf-8"?>
<!-- Tela nativa exibida entre o toque no ícone e o primeiro frame do
     Flutter (lib/pages/splash_page.dart assume a partir daí). Mesma cor e
     marca do splash animado, para não ter um "flash" em branco no meio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
